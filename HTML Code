/* =========================================================
   Scratch card
   ========================================================= */
(function () {
  const c = $("scratchCv"), x = c.getContext("2d");
  c.width = 340; c.height = 190;
  const g = x.createLinearGradient(0, 0, 340, 190);
  g.addColorStop(0, "#d9d3e3"); g.addColorStop(.5, "#f4f0fa"); g.addColorStop(1, "#b9b0c9");
  x.fillStyle = g; x.fillRect(0, 0, 340, 190);
  x.fillStyle = "rgba(107,91,134,.35)";
  for (let i = 0; i < 70; i++) { x.beginPath(); x.arc(Math.random() * 340, Math.random() * 190, Math.random() * 2 + .5, 0, 7); x.fill(); }
  x.fillStyle = "#6b5b86"; x.font = "bold 20px 'Segoe UI', sans-serif"; x.textAlign = "center";
  x.fillText("✨ Scratch here ✨", 170, 98);
  let down = false, done = false;
  const pos = (e) => { const r = c.getBoundingClientRect(); return [(e.clientX - r.left) * c.width / r.width, (e.clientY - r.top) * c.height / r.height]; };
  const scratch = (e) => {
    if (!down || done) return;
    const [px, py] = pos(e);
    x.globalCompositeOperation = "destination-out";
    x.beginPath(); x.arc(px, py, 20, 0, 7); x.fill();
  };
  const check = () => {
    const d = x.getImageData(0, 0, c.width, c.height).data;
    let clear = 0, total = 0;
    for (let i = 3; i < d.length; i += 16) { total++; if (d[i] === 0) clear++; }
    if (clear / total > .4) {
      done = true; c.style.transition = "opacity .8s"; c.style.opacity = "0";
      setTimeout(() => c.style.display = "none", 800);
      const r = c.getBoundingClientRect();
      burst(r.left + r.width / 2, r.top + r.height / 2, 150);
    }
  };
  c.addEventListener("pointerdown", (e) => { down = true; c.setPointerCapture(e.pointerId); scratch(e); });
  c.addEventListener("pointermove", scratch);
  const up = () => { if (!down) return; down = false; check(); };
  c.addEventListener("pointerup", up);
  c.addEventListener("pointercancel", up);
})();

