/* =========================================================
   🎵 MUSIC: starts automatically and loops until she leaves
   - Browsers block sound until the first tap/click, so music starts on the
     very first touch anywhere (including the "Open Your Surprise" button).
   - The built-in tune loops forever. Or set CONFIG.musicFile for your own song.
   - The 🎵 button in the corner mutes / unmutes.
   ========================================================= */
let actx = null, master = null, nextStart = 0, pumpTimer = null;
let audioEl = null, musicOn = false, userMuted = false;

const BEAT = 0.46;
const N = { G4: 392, A4: 440, B4: 494, C5: 523, D5: 587, E5: 659, F5: 698, G5: 784 };
const melody = [
  ["G4", .75], ["G4", .25], ["A4", 1], ["G4", 1], ["C5", 1], ["B4", 2],
  ["G4", .75], ["G4", .25], ["A4", 1], ["G4", 1], ["D5", 1], ["C5", 2],
  ["G4", .75], ["G4", .25], ["G5", 1], ["E5", 1], ["C5", 1], ["B4", 1], ["A4", 2],
  ["F5", .75], ["F5", .25], ["E5", 1], ["C5", 1], ["D5", 1], ["C5", 2]
];
const CH = { C: [130.81, 164.81, 196], G: [98, 123.47, 146.83], F: [87.31, 110, 130.81] };
const chords = [[0, 3, "C"], [3, 3, "G"], [6, 3, "G"], [9, 3, "C"], [12, 4, "C"], [16, 6, "F"], [22, 2, "G"], [24, 4, "C"]];
const CYCLE = 29; // beats per loop (tune + a short breath before it repeats)

function tone(freq, start, dur, type, vol) {
  const o = actx.createOscillator(), g = actx.createGain();
  o.type = type; o.frequency.value = freq;
  g.gain.setValueAtTime(0, start);
  g.gain.linearRampToValueAtTime(vol, start + .03);
  g.gain.exponentialRampToValueAtTime(.001, start + dur);
  o.connect(g); g.connect(master);
  o.start(start); o.stop(start + dur + .05);
}
function pad(freqs, start, dur) {
  freqs.forEach(f => {
    const o = actx.createOscillator(), g = actx.createGain();
    o.type = "sine"; o.frequency.value = f;
    g.gain.setValueAtTime(0, start);
    g.gain.linearRampToValueAtTime(.05, start + .2);
    g.gain.setValueAtTime(.05, start + dur - .25);
    g.gain.linearRampToValueAtTime(0, start + dur);
    o.connect(g); g.connect(master);
    o.start(start); o.stop(start + dur + .05);
  });
}
function scheduleCycle(t0) {
  let t = t0;
  melody.forEach(([n, b]) => { tone(N[n], t, b * BEAT * .95, "triangle", .17); t += b * BEAT; });
  chords.forEach(([s, d, c]) => pad(CH[c], t0 + s * BEAT, d * BEAT));
}
function pump() {
  if (!actx) return;
  while (nextStart < actx.currentTime + 3) { scheduleCycle(nextStart); nextStart += CYCLE * BEAT; }
}
function synthPlay() {
  if (!actx) {
    actx = new (window.AudioContext || window.webkitAudioContext)();
    master = actx.createGain(); master.gain.value = 0; master.connect(actx.destination);
  }
  return actx.resume().then(() => {
    const now = actx.currentTime;
    master.gain.cancelScheduledValues(now);
    master.gain.setValueAtTime(master.gain.value, now);
    master.gain.linearRampToValueAtTime(.9, now + 1.2);
    if (!pumpTimer) { nextStart = now + .15; pump(); pumpTimer = setInterval(pump, 400); }
  });
}
function filePlay() {
  if (!audioEl) { audioEl = new Audio(CONFIG.musicFile); audioEl.loop = true; audioEl.volume = .6; }
  return audioEl.play();
}

function setMusicUI(on) {
  $("musicBtn").textContent = on ? "Music: On 🔊" : "Music: Off 🔇";
  $("fabMusic").classList.toggle("on", on);
  $("fabMusic").textContent = on ? "🔊" : "🔇";
}
function startMusic() {
  if (userMuted) return;
  let p;
  try { p = CONFIG.musicFile ? filePlay() : synthPlay(); } catch (e) { return; }
  Promise.resolve(p).then(() => {
    if (userMuted) { pauseMusic(); return; }
    musicOn = true; setMusicUI(true); unhook();
  }).catch(() => { /* blocked until the next tap, listeners below will retry */ });
}
function pauseMusic() {
  musicOn = false;
  if (audioEl) audioEl.pause();
  if (actx) actx.suspend();
  setMusicUI(false);
}
function toggleMusic() {
  if (musicOn) { userMuted = true; pauseMusic(); }
  else { userMuted = false; startMusic(); }
}

// Try to start straight away; if the browser blocks it, start on the very first tap/key/scroll.
const gestureEvents = ["pointerdown", "touchstart", "click", "keydown", "wheel"];
function onGesture() { if (!musicOn) startMusic(); }
function unhook() { gestureEvents.forEach(ev => window.removeEventListener(ev, onGesture)); }
gestureEvents.forEach(ev => window.addEventListener(ev, onGesture, { passive: true }));
startMusic();
setMusicUI(false);

// Keep it going when she comes back to the tab or the phone wakes up
document.addEventListener("visibilitychange", () => {
  if (document.hidden || !musicOn) return;
  if (actx && actx.state !== "running") actx.resume().catch(() => {});
  if (audioEl && audioEl.paused) audioEl.play().catch(() => {});
});

/* =========================================================
   Cursor sparkle trail (mouse only)
   ========================================================= */
if (!reduce && window.matchMedia("(pointer: fine)").matches) {
  let last = 0;
  window.addEventListener("pointermove", (e) => {
    const now = performance.now();
    if (now - last < 70) return;
    last = now;
    const s = document.createElement("span");
    s.className = "spark"; s.textContent = Math.random() > .5 ? "✦" : "♡";
    s.style.left = e.clientX + "px"; s.style.top = e.clientY + "px";
    document.body.appendChild(s);
    setTimeout(() => s.remove(), 900);
  });
}
