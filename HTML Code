<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#170f2b">
<title>Happy 23rd Birthday 💐</title>

<style>
:root {
  --bg1: #170f2b;
  --bg2: #542044;
  --bg3: #a83265;
  --pink: #ff9fc5;
  --pink-soft: #ffd5e5;
  --text: #ffe6ef;
  --gold: #ffd58a;
  --glass: rgba(255, 255, 255, 0.08);
  --glass-border: rgba(255, 255, 255, 0.18);
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
  color: white;
  text-align: center;
  background: linear-gradient(135deg, var(--bg1), var(--bg2), var(--bg3));
  background-size: 200% 200%;
  animation: drift 18s ease-in-out infinite alternate;
  min-height: 100vh;
  overflow-x: hidden;
}
body.locked { overflow: hidden; }
@keyframes drift { to { background-position: 100% 100%; } }

canvas#bg, canvas#confetti {
  position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none;
}
canvas#bg { z-index: 0; }
canvas#confetti { z-index: 95; }

main, footer { position: relative; z-index: 1; }

#progress {
  position: fixed; top: 0; left: 0; height: 4px; width: 0;
  background: linear-gradient(90deg, var(--gold), #ff83b0);
  z-index: 60; box-shadow: 0 0 12px #ff83b0aa;
}

/* ---------- Small floating music button ---------- */
.fab {
  position: fixed; top: 14px; right: 14px; z-index: 110;
  width: 44px; height: 44px; padding: 0; margin: 0; border-radius: 50%;
  font-size: 19px; line-height: 1;
  background: rgba(23, 15, 43, .55); color: #fff;
  border: 1px solid var(--glass-border); backdrop-filter: blur(8px);
}
.fab.on { box-shadow: 0 0 18px #ff83b0aa; border-color: #ff9fc5aa; }

/* ---------- Splash ---------- */
#splash {
  position: fixed; inset: 0; z-index: 100;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 24px;
  background: radial-gradient(circle at 50% 40%, rgba(120, 35, 88, .92), rgba(15, 8, 32, .96));
  backdrop-filter: blur(6px);
  transition: opacity 1s ease, visibility 1s ease;
}
#splash.hide { opacity: 0; visibility: hidden; }
#splash .env { font-size: 96px; animation: bounce 2s ease-in-out infinite; filter: drop-shadow(0 0 30px #ff83b0aa); }
#splash h1 { font-size: clamp(1.8rem, 6vw, 3rem); margin: 18px 0 10px; }
#splash p { max-width: 460px; color: var(--text); line-height: 1.8; margin-bottom: 20px; }
@keyframes bounce { 50% { transform: translateY(-14px) rotate(-4deg); } }

.sig {
  margin-top: 12px; font-size: 12px; letter-spacing: 1.5px;
  font-style: italic; color: var(--gold); opacity: .8;
}

/* ---------- Hero ---------- */
.hero {
  min-height: 100vh;
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  padding: 40px 20px;
}
.tag {
  border: 1px solid #ffb6d0; padding: 10px 22px; border-radius: 30px;
  color: var(--pink-soft); letter-spacing: 3px; font-size: 12px;
  background: var(--glass); backdrop-filter: blur(6px);
}
h1 { font-size: clamp(2.7rem, 8vw, 5.5rem); margin: 25px 0 12px; line-height: 1.15; }
.name {
  font-family: Georgia, serif; font-style: italic;
  background: linear-gradient(90deg, #ff9fc5, #ffd58a, #ff9fc5);
  background-size: 200% auto;
  -webkit-background-clip: text; background-clip: text; color: transparent;
  animation: shine 4s linear infinite;
}
@keyframes shine { to { background-position: 200% center; } }

.age {
  display: inline-block; margin-bottom: 22px; padding: 8px 22px;
  border-radius: 30px; font-weight: 800; letter-spacing: 2px;
  color: #41152e; background: linear-gradient(135deg, var(--gold), #ff83b0);
  box-shadow: 0 0 30px #ff83b055;
  animation: pulse 2.4s ease-in-out infinite;
}
@keyframes pulse { 50% { transform: scale(1.07); } }

.subtitle { max-width: 620px; line-height: 1.8; color: var(--text); font-size: 18px; min-height: 5.4em; }
.caret::after { content: "|"; margin-left: 2px; animation: blink 1s steps(2) infinite; color: var(--pink); }
@keyframes blink { 50% { opacity: 0; } }

.heart {
  font-size: 90px; margin: 14px; padding: 0; cursor: pointer; user-select: none;
  filter: drop-shadow(0 0 20px #ff6fa7aa);
  animation: beat 1.3s infinite; background: none; border: none;
}
.heart:active { transform: scale(.9); }
@keyframes beat { 0%,100% { transform: scale(1); } 50% { transform: scale(1.18); } }
.hint { font-size: 12px; color: var(--pink-soft); opacity: .8; margin-bottom: 10px; }

/* ---------- Buttons ---------- */
button {
  background: linear-gradient(135deg, var(--gold), #ff83b0);
  color: #41152e; border: none; padding: 14px 24px; margin: 8px 6px;
  border-radius: 30px; font-size: 16px; font-weight: 700; cursor: pointer;
  transition: transform .25s, box-shadow .25s; font-family: inherit;
}
button:hover { transform: translateY(-3px); box-shadow: 0 8px 25px #ff83b066; }
button:focus-visible, .heart:focus-visible, .cake:focus-visible, .gift-wrap:focus-visible,
.flip:focus-visible, .ow-head:focus-visible, .polaroid:focus-visible, input:focus-visible {
  outline: 3px solid #fff; outline-offset: 3px;
}
button.ghost { background: var(--glass); color: white; border: 1px solid var(--glass-border); }

.scroll-cue { margin-top: 30px; font-size: 13px; color: var(--pink-soft); opacity: .8; animation: bob 2s ease-in-out infinite; }
@keyframes bob { 50% { transform: translateY(8px); } }

/* ---------- Sections ---------- */
section { padding: 80px 20px; }
h2 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 14px; color: #ffc2d8; }
.lead { max-width: 620px; margin: 0 auto 10px; line-height: 1.8; color: var(--text); }

.reveal { opacity: 0; transform: translateY(35px); transition: opacity .9s ease, transform .9s ease; }
.reveal.show { opacity: 1; transform: none; }

/* ---------- Live counter ---------- */
.units { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin: 32px auto 0; max-width: 900px; }
.unit {
  min-width: 120px; padding: 22px 16px; border-radius: 22px;
  background: var(--glass); border: 1px solid var(--glass-border); backdrop-filter: blur(8px);
}
.unit b { display: block; font-size: clamp(1.7rem, 5vw, 2.5rem); color: var(--gold); font-variant-numeric: tabular-nums; }
.unit span { font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: var(--pink-soft); }
.unit.wide { min-width: 220px; }

/* ---------- Cake ---------- */
.cake-wrap { margin: 40px auto 10px; display: flex; flex-direction: column; align-items: center; }
.cake { position: relative; width: 230px; height: 220px; cursor: pointer; }
.layer { position: absolute; left: 50%; transform: translateX(-50%); border-radius: 14px; }
.layer.bot { bottom: 14px; width: 230px; height: 70px; background: linear-gradient(#ffb3cf, #ff83b0); }
.layer.mid { bottom: 84px; width: 180px; height: 58px; background: linear-gradient(#fff0f6, #ffc2d8); }
.layer.top { bottom: 142px; width: 130px; height: 48px; background: linear-gradient(#ffe0a8, #ffbf69); }
.layer::before {
  content: ""; position: absolute; top: -2px; left: 0; right: 0; height: 18px;
  background: radial-gradient(circle at 10px 0, #fff 10px, transparent 11px) repeat-x;
  background-size: 22px 18px; opacity: .95;
}
.plate {
  position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 260px; height: 16px; border-radius: 50%;
  background: linear-gradient(#e9e3f0, #a79bb8); box-shadow: 0 8px 20px #0006;
}
.candles { position: absolute; bottom: 188px; left: 50%; transform: translateX(-50%); display: flex; gap: 22px; }
.candle {
  position: relative; display: block; width: 10px; height: 34px; border-radius: 3px;
  background: repeating-linear-gradient(45deg, #fff 0 5px, #ff83b0 5px 10px);
}
.flame {
  position: absolute; left: 50%; top: -24px; transform: translateX(-50%);
  width: 14px; height: 22px;
  background: radial-gradient(ellipse at 50% 75%, #fff7c2 10%, #ffb62e 55%, #ff6a00 100%);
  border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
  box-shadow: 0 0 18px 6px #ffb62e88; transform-origin: 50% 90%;
  animation: flicker .18s infinite alternate; transition: opacity .4s, transform .4s;
}
@keyframes flicker {
  from { transform: translateX(-50%) scale(1, 1) rotate(-3deg); }
  to   { transform: translateX(-50%) scale(.92, 1.1) rotate(3deg); }
}
.cake.out .flame { opacity: 0; transform: translateX(-50%) scale(0); animation: none; }
.smoke { position: absolute; left: 50%; top: -30px; width: 6px; height: 6px; border-radius: 50%; background: #ffffff88; opacity: 0; }
.cake.out .smoke { animation: smoke 1.6s ease-out forwards; }
@keyframes smoke { from { opacity: .8; transform: translateY(0) scale(1); } to { opacity: 0; transform: translateY(-50px) scale(5); } }
#wishText { margin-top: 26px; min-height: 2.2em; color: var(--gold); font-size: 20px; font-style: italic; font-family: Georgia, serif; }

/* ---------- Timeline ---------- */
.timeline { position: relative; max-width: 900px; margin: 45px auto 0; }
.timeline::before {
  content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px;
  background: linear-gradient(var(--gold), var(--pink), transparent); transform: translateX(-50%);
}
.t-item { position: relative; width: 50%; padding: 0 38px 40px 0; text-align: right; }
.t-item:nth-child(even) { margin-left: 50%; padding: 0 0 40px 38px; text-align: left; }
.t-item::after {
  content: ""; position: absolute; top: 24px; right: -8px; width: 16px; height: 16px; border-radius: 50%;
  background: var(--gold); box-shadow: 0 0 0 5px #ffd58a33, 0 0 20px var(--gold);
}
.t-item:nth-child(even)::after { right: auto; left: -8px; }
.t-card {
  background: var(--glass); border: 1px solid var(--glass-border);
  border-radius: 22px; padding: 22px; backdrop-filter: blur(8px);
  transition: transform .35s, border-color .35s;
}
.t-card:hover { transform: translateY(-5px); border-color: #ff9fc5aa; }
.t-card img { width: 100%; max-height: 220px; object-fit: cover; border-radius: 14px; margin-bottom: 12px; }
.t-emoji { font-size: 40px; margin-bottom: 6px; }
.t-date { font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 4px; }
.t-card h3 { color: var(--pink-soft); margin-bottom: 6px; }
.t-card p { color: var(--text); line-height: 1.7; font-size: 15px; }

/* ---------- Gallery ---------- */
.gallery { display: flex; flex-wrap: wrap; justify-content: center; gap: 26px; max-width: 1000px; margin: 40px auto 0; }
.polaroid {
  background: #fff; color: #41152e; padding: 10px 10px 14px; width: 220px; border-radius: 6px;
  box-shadow: 0 14px 34px #0006; transform: rotate(var(--r, 0deg)); cursor: zoom-in;
  transition: transform .35s, box-shadow .35s;
}
.polaroid:hover { transform: rotate(0) scale(1.06); box-shadow: 0 20px 44px #0008; }
.polaroid img { width: 100%; height: 200px; object-fit: cover; display: block; border-radius: 3px; }
.polaroid figcaption { margin-top: 10px; font-family: Georgia, serif; font-style: italic; font-size: 14px; }
#lightbox {
  display: none; position: fixed; inset: 0; z-index: 85; padding: 20px;
  background: rgba(10, 5, 20, .92); align-items: center; justify-content: center; flex-direction: column; cursor: zoom-out;
}
#lightbox.show { display: flex; animation: fadeIn .4s ease; }
#lightbox img { max-width: min(92vw, 760px); max-height: 74vh; border-radius: 10px; box-shadow: 0 0 60px #ff6fa755; }
#lightbox p { margin-top: 14px; color: var(--pink-soft); font-style: italic; font-family: Georgia, serif; }

/* ---------- Flip cards ---------- */
.flip-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; max-width: 1000px; margin: 35px auto 0; }
.flip { width: 250px; height: 190px; perspective: 900px; cursor: pointer; border-radius: 22px; }
.flip-inner { position: relative; width: 100%; height: 100%; transition: transform .8s; transform-style: preserve-3d; }
.flip.flipped .flip-inner { transform: rotateY(180deg); }
.face {
  position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden;
  border-radius: 22px; padding: 22px; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 6px;
  border: 1px solid var(--glass-border); background: rgba(255, 255, 255, .1);
}
.face .emoji { font-size: 44px; }
.face h3 { color: var(--pink-soft); }
.face small { color: var(--pink-soft); opacity: .75; }
.face.back { transform: rotateY(180deg); background: linear-gradient(145deg, #6a2652, #3a1a4a); font-size: 15px; line-height: 1.7; color: var(--text); }
.face.back b { color: var(--gold); }

/* ---------- Open when ---------- */
.ow-wrap { max-width: 720px; margin: 35px auto 0; display: grid; gap: 14px; }
.ow { background: var(--glass); border: 1px solid var(--glass-border); border-radius: 20px; text-align: left; overflow: hidden; backdrop-filter: blur(8px); }
.ow-head { display: flex; align-items: center; gap: 14px; padding: 18px 20px; cursor: pointer; font-weight: 600; color: var(--pink-soft); }
.ow-head .ic { font-size: 30px; transition: transform .4s; }
.ow.open .ow-head .ic { transform: rotate(-12deg) scale(1.15); }
.ow-head .arrow { margin-left: auto; transition: transform .4s; }
.ow.open .arrow { transform: rotate(180deg); }
.ow-body { max-height: 0; overflow: hidden; transition: max-height .6s ease, padding .4s; padding: 0 22px; line-height: 1.9; color: var(--text); }
.ow.open .ow-body { max-height: 420px; padding: 0 22px 20px; }

/* ---------- Note jar ---------- */
.jar-card {
  max-width: 520px; min-height: 120px; margin: 26px auto 0; padding: 26px 24px; border-radius: 24px;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(145deg, #ffffff1c, #ffffff0a); border: 1px dashed var(--gold);
  font-family: Georgia, serif; font-style: italic; font-size: 20px; line-height: 1.7; color: var(--gold);
}
.jar-card.pop { animation: appear .5s ease; }

/* ---------- Lantern ---------- */
.lantern-form { margin-top: 26px; }
input[type="text"] {
  width: min(340px, 82vw); padding: 14px 20px; margin: 8px 6px; border-radius: 30px;
  background: var(--glass); color: #fff; border: 1px solid var(--glass-border);
  font-size: 16px; font-family: inherit; text-align: center;
}
input[type="text"]::placeholder { color: var(--pink-soft); opacity: .7; }
#lanterns { position: fixed; inset: 0; z-index: 30; pointer-events: none; overflow: hidden; }
.lantern {
  position: absolute; bottom: -140px; width: 130px; margin-left: -65px; text-align: center;
  animation: rise 11s ease-in forwards;
}
.lantern .lbody {
  width: 58px; height: 74px; margin: 0 auto; border-radius: 14px 14px 20px 20px;
  background: linear-gradient(#ffe9a8, #ff8a3d); box-shadow: 0 0 40px 10px #ffb62e88;
}
.lantern small { display: block; margin-top: 8px; color: var(--gold); font-size: 12px; line-height: 1.3; text-shadow: 0 0 8px #000a; }
@keyframes rise {
  0% { transform: translate(0, 0); opacity: 0; }
  8% { opacity: 1; }
  100% { transform: translate(var(--dx, 30px), -120vh); opacity: 0; }
}

/* ---------- Scratch ---------- */
.scratch {
  position: relative; width: min(340px, 86vw); height: 190px; margin: 30px auto 0;
  border-radius: 22px; overflow: hidden; border: 2px solid var(--gold); box-shadow: 0 0 40px #ffd58a33;
}
.scratch .prize {
  position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 18px; background: linear-gradient(135deg, #fff3d6, #ffc2d8); color: #41152e; font-weight: 700; line-height: 1.5;
}
.scratch .prize .big { font-size: 38px; }
.scratch canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: crosshair; }

/* ---------- Gift ---------- */
.gift-section { max-width: 760px; margin: 0 auto; }
.gift-wrap { position: relative; width: 170px; height: 190px; margin: 40px auto 10px; cursor: pointer; animation: wiggle 2.6s ease-in-out infinite; }
.gift-wrap.open { animation: none; cursor: default; }
@keyframes wiggle {
  0%, 70%, 100% { transform: rotate(0); }
  75% { transform: rotate(-4deg); } 80% { transform: rotate(4deg); }
  85% { transform: rotate(-3deg); } 90% { transform: rotate(3deg); }
}
.gift-glow {
  position: absolute; left: 50%; top: 30%; width: 260px; height: 260px;
  transform: translate(-50%, -50%) scale(0);
  background: radial-gradient(circle, #ffd58a99, #ff83b044 45%, transparent 70%);
  border-radius: 50%; transition: transform .8s ease; pointer-events: none;
}
.gift-wrap.open .gift-glow { transform: translate(-50%, -50%) scale(1); }
.gift-body {
  position: absolute; bottom: 0; left: 10px; width: 150px; height: 112px;
  border-radius: 8px 8px 14px 14px; background: linear-gradient(135deg, #ff6fa7, #c2307a); box-shadow: 0 14px 30px #0006;
}
.gift-lid {
  position: absolute; bottom: 104px; left: 0; width: 170px; height: 42px; border-radius: 10px;
  background: linear-gradient(135deg, #ff83b0, #d63c86); box-shadow: 0 6px 14px #0005;
  transition: transform .9s cubic-bezier(.3, 1.4, .5, 1), opacity .9s; transform-origin: 0% 100%;
}
.gift-body::before, .gift-lid::before {
  content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 26px; transform: translateX(-50%);
  background: linear-gradient(90deg, #ffe0a8, #ffbf69, #ffe0a8);
}
.bow { position: absolute; left: 50%; top: -34px; transform: translateX(-50%); font-size: 46px; filter: drop-shadow(0 4px 6px #0006); }
.gift-wrap.open .gift-lid { transform: translate(-30px, -90px) rotate(-26deg); opacity: 0; }
.gift-btn { font-size: 17px; padding: 16px 28px; margin-top: 18px; }
.gift-btn.done { display: none; }
.gift-msg {
  display: none; margin: 26px auto 0; max-width: 560px; padding: 30px 26px; border-radius: 24px;
  background: linear-gradient(145deg, #ffffff1c, #ffffff0a); border: 1px solid var(--gold);
  box-shadow: 0 0 50px #ffd58a33; backdrop-filter: blur(10px);
}
.gift-msg.show { display: block; animation: appear .7s ease; }
.gift-msg .big { font-family: Georgia, serif; font-style: italic; font-size: clamp(1.4rem, 4.5vw, 2rem); line-height: 1.5; color: var(--gold); }
.gift-msg .big b {
  background: linear-gradient(90deg, #ff9fc5, #ffd58a, #ff9fc5); background-size: 200% auto;
  -webkit-background-clip: text; background-clip: text; color: transparent; animation: shine 3s linear infinite;
}
.gift-msg .sub { margin-top: 14px; color: var(--text); line-height: 1.8; }

/* ---------- Take care ---------- */
.care-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; max-width: 1000px; margin: 35px auto 0; }
.care { width: 220px; padding: 26px 18px; border-radius: 22px; background: var(--glass); border: 1px solid var(--glass-border); backdrop-filter: blur(8px); }
.care .emoji { font-size: 42px; display: block; margin-bottom: 8px; animation: bob 3s ease-in-out infinite; }
.care h3 { color: var(--pink-soft); margin-bottom: 6px; font-size: 18px; }
.care p { font-size: 14px; line-height: 1.7; color: var(--text); }

.promise { max-width: 560px; margin: 45px auto 0; text-align: left; padding: 28px 26px; border-radius: 24px; background: var(--glass); border: 1px solid var(--glass-border); backdrop-filter: blur(8px); }
.promise h3 { text-align: center; color: var(--gold); margin-bottom: 4px; }
.promise .small { text-align: center; font-size: 14px; color: var(--pink-soft); margin-bottom: 16px; }
.promise label { display: flex; align-items: center; gap: 12px; padding: 11px 6px; cursor: pointer; line-height: 1.5; border-bottom: 1px dashed #ffffff22; color: var(--text); }
.promise label:last-of-type { border-bottom: none; }
.promise input { width: 20px; height: 20px; accent-color: #ff83b0; flex: none; }
.promise input:checked + span { text-decoration: line-through; opacity: .65; }
.bar { height: 8px; border-radius: 6px; background: #ffffff1c; margin-top: 16px; overflow: hidden; }
.bar i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--gold), #ff83b0); transition: width .5s; }
#promiseMsg { text-align: center; margin-top: 14px; min-height: 1.6em; color: var(--gold); font-weight: 600; }

/* ---------- Letter ---------- */
.letter-btn { font-size: 18px; padding: 16px 30px; }
.letter {
  display: none; max-width: 760px; margin: 30px auto 0; padding: 40px 36px; border-radius: 26px;
  background: var(--glass); border: 1px solid var(--glass-border); backdrop-filter: blur(10px);
  line-height: 2; color: var(--text); text-align: left; box-shadow: 0 20px 60px #0004;
}
.letter.open { display: block; animation: appear .6s ease; }
.letter p { margin-bottom: 18px; opacity: 0; }
.letter.open p { animation: lineIn .8s ease forwards; }
@keyframes lineIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
.letter .sign { font-size: 22px; color: var(--pink); font-family: Georgia, serif; font-style: italic; text-align: right; margin-bottom: 0; line-height: 1.5; }

footer { padding: 40px 15px 60px; color: var(--pink-soft); line-height: 1.9; }

/* ---------- Modal ---------- */
#surprise {
  display: none; position: fixed; inset: 0; background: rgba(16, 7, 25, .88); backdrop-filter: blur(4px);
  z-index: 40; align-items: center; justify-content: center; padding: 20px;
}
.surprise-box {
  max-width: 560px; padding: 40px 28px; background: linear-gradient(145deg, #572047, #271332);
  border: 1px solid var(--pink); border-radius: 26px; box-shadow: 0 0 60px #ff6fa755; animation: appear .4s ease;
}
@keyframes appear { from { transform: scale(.75); opacity: 0; } to { transform: scale(1); opacity: 1; } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.surprise-box h2 { margin-bottom: 8px; }
.surprise-box p { line-height: 1.9; margin: 16px 0 22px; color: var(--text); }

/* ---------- Goodnight ---------- */
#night {
  display: none; position: fixed; inset: 0; z-index: 90; padding: 24px;
  flex-direction: column; align-items: center; justify-content: center; overflow: hidden;
