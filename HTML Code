  reasons: [
    { emoji: "😊", title: "Your smile",       text: "It can brighten the heaviest day in a single second." },
    { emoji: "💖", title: "Your kind heart",  text: "You care deeply, and everyone around you feels it." },
    { emoji: "😂", title: "Your laugh",       text: "One of my favourite sounds, and it's contagious in the best way." },
    { emoji: "🌟", title: "Your strength",    text: "You keep going with grace, and it inspires me every day." },
    { emoji: "🤗", title: "How you care",     text: "The little things you do mean the most." },
    { emoji: "🌷", title: "Simply you",       text: "Just as you are, you're someone truly special." }
  ],

  openWhen: [
    { icon: "😊", title: "Open when you need a smile",   text: "Think of the last time you laughed until your stomach hurt. That joy belongs to you, and there's plenty more on the way. You're doing wonderfully! 🌸" },
    { icon: "😔", title: "Open when you feel low",       text: "You are stronger than this moment. Take a deep breath, drink some water, and remember how many people care about you. Better days are right around the corner. 🌷" },
    { icon: "🌙", title: "Open when you can't sleep",    text: "Put the phone down, breathe slowly, and let your thoughts rest. Tomorrow will take care of itself. Sleep well and sweet dreams. 😴" },
    { icon: "🥗", title: "Open when you skip meals",     text: "Go and eat something healthy right now, please. 🥗 You can't pour from an empty cup. Your health matters, and so do you. Drink some water too! 💧" }
  ],

  jar: [
    "You make ordinary days feel brighter. ☀️",
    "Be proud of how far you've come. 🌟",
    "A glass of water and a deep breath. You've got this! 💧",
    "Your smile is your superpower. 😊",
    "Rest is productive too. Sleep well tonight. 😴",
    "Someone out there is grateful you exist today. 💐",
    "Eat something yummy and healthy, you deserve it. 🥗",
    "Everything is working out, one step at a time. 🌱"
  ],

  scratch: { title: "1 Special Treat of Your Choice 🍰", text: "Dessert, dinner or coffee. You pick the place, valid anytime! 🎉" }
};

/* =========================================================
   Setup
   ========================================================= */
const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
const $ = (id) => document.getElementById(id);
const go = (id) => $(id).scrollIntoView({ behavior: reduce ? "auto" : "smooth" });
const esc = (s) => String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

const display = CONFIG.herName + (CONFIG.nickname ? " " + CONFIG.nickname : "");
document.title = "Happy 23rd Birthday " + display + " 💐";
document.querySelectorAll("[data-name]").forEach(e => e.textContent = display);
document.querySelectorAll("[data-his]").forEach(e => e.textContent = CONFIG.hisName);
document.querySelectorAll("[data-full]").forEach(e => e.textContent = CONFIG.fullName);

/* ---------- Render dynamic sections ---------- */
$("timeline").innerHTML = CONFIG.memories.map(m => `
  <div class="t-item reveal"><div class="t-card">
    ${m.img ? `<img src="${esc(m.img)}" alt="${esc(m.title)}" loading="lazy">` : `<div class="t-emoji">${esc(m.emoji || "🌸")}</div>`}
    <div class="t-date">${esc(m.date)}</div><h3>${esc(m.title)}</h3><p>${esc(m.text)}</p>
  </div></div>`).join("");

if (CONFIG.photos.length) {
  $("galleryGrid").innerHTML = CONFIG.photos.map((p, i) => `
    <figure class="polaroid reveal" tabindex="0" role="button" data-i="${i}" style="--r:${(i % 2 ? 2.5 : -2.5) + (i % 3) * .6}deg">
      <img src="${esc(p.src)}" alt="${esc(p.caption || "Memory")}" loading="lazy">
      <figcaption>${esc(p.caption || "")}</figcaption>
    </figure>`).join("");
} else {
  $("gallery").style.display = "none";
}

$("flipGrid").innerHTML = CONFIG.reasons.map((r, i) => `
  <div class="flip reveal" role="button" tabindex="0" aria-label="Reason ${i + 1}, tap to flip">
    <div class="flip-inner">
      <div class="face front"><div class="emoji">${esc(r.emoji)}</div><h3>Reason #${i + 1}</h3><small>tap to reveal</small></div>
      <div class="face back"><div><b>${esc(r.title)}</b><br>${esc(r.text)}</div></div>
    </div>
  </div>`).join("");

$("owWrap").innerHTML = CONFIG.openWhen.map(o => `
  <div class="ow reveal">
    <div class="ow-head" role="button" tabindex="0"><span class="ic">${esc(o.icon)}</span><span>${esc(o.title)}</span><span class="arrow">▾</span></div>
    <div class="ow-body">${esc(o.text)}</div>
  </div>`).join("");

$("prizeTitle").textContent = CONFIG.scratch.title;
$("prizeText").textContent = CONFIG.scratch.text;

$("flipGrid").addEventListener("click", (e) => { const f = e.target.closest(".flip"); if (f) { f.classList.toggle("flipped"); if (f.classList.contains("flipped")) burst(e.clientX, e.clientY, 18); } });
$("flipGrid").addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { const f = e.target.closest(".flip"); if (f) { e.preventDefault(); f.classList.toggle("flipped"); } } });
$("owWrap").addEventListener("click", (e) => { const o = e.target.closest(".ow"); if (o) o.classList.toggle("open"); });
$("owWrap").addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { const o = e.target.closest(".ow"); if (o) { e.preventDefault(); o.classList.toggle("open"); } } });

/* ---------- Gallery lightbox ---------- */
function openLightbox(i) {
  const p = CONFIG.photos[i]; if (!p) return;
  $("lbImg").src = p.src; $("lbImg").alt = p.caption || "Memory";
  $("lbCap").textContent = p.caption || "";
  $("lightbox").classList.add("show");
}
function closeLightbox() { $("lightbox").classList.remove("show"); }
$("galleryGrid").addEventListener("click", (e) => { const f = e.target.closest(".polaroid"); if (f) openLightbox(+f.dataset.i); });
$("galleryGrid").addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { const f = e.target.closest(".polaroid"); if (f) { e.preventDefault(); openLightbox(+f.dataset.i); } } });

/* =========================================================
   Background: twinkling stars + rising hearts
   ========================================================= */
const bg = $("bg"), bctx = bg.getContext("2d");
let W = 0, H = 0, stars = [], hearts = [];

function resize() {
  const d = Math.min(window.devicePixelRatio || 1, 2);
  W = window.innerWidth; H = window.innerHeight;
  bg.width = W * d; bg.height = H * d;
  bctx.setTransform(d, 0, 0, d, 0, 0);
  const count = reduce ? 40 : Math.round((W * H) / 14000);
  stars = Array.from({ length: count }, () => ({
    x: Math.random() * W, y: Math.random() * H,
    r: Math.random() * 1.6 + .3, p: Math.random() * Math.PI * 2, s: Math.random() * .02 + .005
  }));
  hearts = Array.from({ length: reduce ? 0 : 16 }, () => newHeart(true));
}
function newHeart(anywhere) {
  return {
    x: Math.random() * W, y: anywhere ? Math.random() * H : H + 30,
    size: 12 + Math.random() * 18, v: .25 + Math.random() * .5,
    ph: Math.random() * Math.PI * 2, ch: ["💗", "✨", "🌸"][(Math.random() * 3) | 0]
  };
}
function drawBg() {
  bctx.clearRect(0, 0, W, H);
  for (const s of stars) {
    s.p += s.s;
    bctx.globalAlpha = .35 + Math.abs(Math.sin(s.p)) * .65;
    bctx.fillStyle = "#fff";
    bctx.beginPath(); bctx.arc(s.x, s.y, s.r, 0, 7); bctx.fill();
  }
  bctx.globalAlpha = .55;
  for (const h of hearts) {
    h.y -= h.v; h.ph += .02;
    bctx.font = h.size + "px serif";
    bctx.fillText(h.ch, h.x + Math.sin(h.ph) * 14, h.y);
    if (h.y < -40) Object.assign(h, newHeart(false));
  }
  bctx.globalAlpha = 1;
  requestAnimationFrame(drawBg);
}
window.addEventListener("resize", resize);
resize(); drawBg();

/* =========================================================
   Confetti + fireworks
   ========================================================= */
const cv = $("confetti"), cctx = cv.getContext("2d");
let parts = [], rockets = [], running = false;
const colors = ["#ff83b0", "#ffd58a", "#ff9fc5", "#ffffff", "#c9a7ff", "#8fe3ff"];
const pick = () => colors[(Math.random() * colors.length) | 0];

function sizeConfetti() { cv.width = window.innerWidth; cv.height = window.innerHeight; }
sizeConfetti(); window.addEventListener("resize", sizeConfetti);
function ensureRun() { if (!running) { running = true; requestAnimationFrame(tick); } }

function burst(x, y, n = 90) {
  if (reduce) n = 25;
  for (let i = 0; i < n; i++) {
    const a = Math.random() * Math.PI * 2, sp = 3 + Math.random() * 8;
    parts.push({
      x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 4,
      w: 6 + Math.random() * 7, h: 4 + Math.random() * 5,
      rot: Math.random() * 6, vr: (Math.random() - .5) * .35,
      c: pick(), life: 140 + Math.random() * 60, heart: Math.random() < .18
    });
  }
  ensureRun();
}
function burstCenter() { burst(window.innerWidth / 2, window.innerHeight / 2.2, 140); }
function rain() {
  if (reduce) return burstCenter();
  for (let i = 0; i < 8; i++) setTimeout(() => burst(Math.random() * window.innerWidth, window.innerHeight * (.15 + Math.random() * .3), 55), i * 220);
}
function firework() {
  rockets.push({ x: cv.width * (.15 + Math.random() * .7), y: cv.height, vy: -(10 + Math.random() * 4), ty: cv.height * (.15 + Math.random() * .3), c: pick() });
  ensureRun();
}
function fireworks() { for (let i = 0; i < 12; i++) setTimeout(firework, i * 500); }
function explode(x, y, c) {
  const n = reduce ? 20 : 80;
  for (let i = 0; i < n; i++) {
    const a = Math.PI * 2 * i / n, sp = 2 + Math.random() * 4.5;
    parts.push({ x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, r: 2 + Math.random() * 1.5, c, life: 70 + Math.random() * 30, circle: true, g: .05, rot: 0, vr: 0 });
  }
}
function tick() {
  cctx.clearRect(0, 0, cv.width, cv.height);
  rockets = rockets.filter(r => {
    r.y += r.vy;
    cctx.fillStyle = r.c; cctx.fillRect(r.x - 1.5, r.y, 3, 14);
    if (r.y <= r.ty) { explode(r.x, r.y, r.c); return false; }
    return true;
  });
  parts = parts.filter(p => p.life > 0 && p.y < cv.height + 30);
  for (const p of parts) {
    p.vy += (p.g !== undefined ? p.g : .16); p.vx *= .992; p.x += p.vx; p.y += p.vy; p.rot += p.vr; p.life--;
    cctx.save();
    cctx.translate(p.x, p.y); cctx.rotate(p.rot);
    cctx.globalAlpha = Math.min(1, p.life / 40);
    if (p.circle) { cctx.fillStyle = p.c; cctx.beginPath(); cctx.arc(0, 0, p.r, 0, 7); cctx.fill(); }
    else if (p.heart) { cctx.font = "16px serif"; cctx.fillText("💖", -8, 8); }
    else { cctx.fillStyle = p.c; cctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h); }
    cctx.restore();
  }
  if (parts.length || rockets.length) requestAnimationFrame(tick);
  else { running = false; cctx.clearRect(0, 0, cv.width, cv.height); }
}

/* =========================================================
   Splash + typed subtitle
   ========================================================= */
const intro = "If I could wrap up every little reason you make the world brighter and hand it to you, this page still wouldn't be enough. But it's a start. ✨";
let typingStarted = false;
function startTyping() {
  if (typingStarted) return; typingStarted = true;
  const el = $("typed");
  if (reduce) { el.textContent = intro; el.classList.remove("caret"); return; }
  const chars = Array.from(intro); let i = 0;
  const step = () => {
    el.textContent = chars.slice(0, ++i).join("");
    if (i < chars.length) setTimeout(step, 38);
    else setTimeout(() => el.classList.remove("caret"), 1500);
  };
  setTimeout(step, 600);
}
function enter() {
  $("splash").classList.add("hide");
  document.body.classList.remove("locked");
  window.scrollTo(0, 0);
  burstCenter();
  startTyping();
  startMusic();                 // music begins as soon as she taps the button
}

/* =========================================================
   Live counter
   ========================================================= */
const dob = new Date(CONFIG.dob);
function tickLive() {
  const s = Math.max(0, Math.floor((Date.now() - dob.getTime()) / 1000));
  $("lvDays").textContent = Math.floor(s / 86400).toLocaleString();
  $("lvHrs").textContent = Math.floor(s % 86400 / 3600);
  $("lvMin").textContent = Math.floor(s % 3600 / 60);
  $("lvSec").textContent = s % 60;
  $("lvBeats").textContent = Math.floor(s * 1.2).toLocaleString();
}
if (isNaN(dob.getTime())) $("live").style.display = "none";
else { tickLive(); setInterval(tickLive, 1000); }

/* =========================================================
   Scroll reveal + progress bar
   ========================================================= */
if ("IntersectionObserver" in window) {
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e, idx) => {
      if (e.isIntersecting) {
        e.target.style.transitionDelay = (idx * 90) + "ms";
        e.target.classList.add("show");
        io.unobserve(e.target);
      }
    });
  }, { threshold: .12 });
  document.querySelectorAll(".reveal").forEach(el => io.observe(el));
} else {
  document.querySelectorAll(".reveal").forEach(el => el.classList.add("show"));
}
window.addEventListener("scroll", () => {
  const h = document.documentElement;
  $("progress").style.width = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100 + "%";
}, { passive: true });

/* =========================================================
   Cake (tap or blow into the mic)
   ========================================================= */
const cake = $("cake");
const wishes = [
  "Wish made! May it come true, beautifully and soon. ✨",
  "Your wish is on its way to the stars. 🌟",
  "I have a feeling this one will come true. 💫"
];
let micActive = false;
function blow() {
  if (cake.classList.contains("out")) return;
  micActive = false;
  cake.classList.add("out");
  const r = cake.getBoundingClientRect();
  burst(r.left + r.width / 2, r.top + 30, 120);
  $("wishText").textContent = wishes[(Math.random() * wishes.length) | 0];
  $("relight").style.display = "inline-block";
  $("micBtn2").textContent = "Blow with your mic 🎤";
}
function relight() {
  cake.classList.remove("out");
  $("wishText").textContent = "";
  $("relight").style.display = "none";
}
cake.addEventListener("click", blow);
cake.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); blow(); } });

async function micBlow() {
  if (micActive || cake.classList.contains("out")) return;
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    const ac = new (window.AudioContext || window.webkitAudioContext)();
    const an = ac.createAnalyser(); an.fftSize = 512;
    ac.createMediaStreamSource(stream).connect(an);
    const data = new Uint8Array(an.fftSize);
    micActive = true; $("micBtn2").textContent = "Blow now… 🌬️";
    let hits = 0; const t0 = Date.now();
    const stop = () => { stream.getTracks().forEach(t => t.stop()); ac.close(); micActive = false; $("micBtn2").textContent = "Blow with your mic 🎤"; };
    (function loop() {
      if (!micActive) { stop(); return; }
      an.getByteTimeDomainData(data);
      let sum = 0; for (const v of data) { const x = (v - 128) / 128; sum += x * x; }
      const rms = Math.sqrt(sum / data.length);
      hits = rms > .2 ? hits + 1 : Math.max(0, hits - 1);
      if (hits > 8) { stop(); blow(); return; }
      if (Date.now() - t0 > 20000) { stop(); return; }
      requestAnimationFrame(loop);
    })();
  } catch (e) {
    $("wishText").textContent = "Mic isn't available here, so just tap the cake 🎂";
  }
}

